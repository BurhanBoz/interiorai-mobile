# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# MCP config (contains API keys)
.vscode/mcp.json
*.pem

# Environment / Secrets — NEVER commit these.
# `.env.*` is what actually catches .env.local / .env.production /
# .env.development — `*.env` only matches names ENDING in ".env", so before
# 2026-09-09 the comment claimed a coverage the patterns did not have and
# `git check-ignore .env.production` came back empty.
# Whitelist .env.example so the template stays in repo as documentation.
.env
.env.*
*.env
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local EAS build artifacts
*.ipa
