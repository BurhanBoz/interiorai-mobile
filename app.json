{
  "expo": {
    "name": "Roomframe AI",
    "slug": "roomframeai-mobile",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "roomframeai",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.roomframeai.mobile",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "We save your generated designs to your Photos library so you can keep them or share them elsewhere.",
        "NSPhotoLibraryAddUsageDescription": "We save your generated designs to your Photos library so you can keep them or share them elsewhere.",
        "NSCameraUsageDescription": "We use the camera so you can photograph the room you want to redesign.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        },
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.21314937170-kkccfujdhofi8k1c20eoct10f7l9g4c2"
            ]
          }
        ],
        "CFBundleLocalizations": [
          "en",
          "tr",
          "de",
          "es",
          "it",
          "ja",
          "ko",
          "ar"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E1A16"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.roomframeai.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-image-picker",
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2dc9b11d-0498-4241-9fb6-d49ae99bfbe9"
      }
    }
  }
}